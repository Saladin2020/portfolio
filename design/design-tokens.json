  "gradient": {
    "$type": "gradient",
    "emphasis-on-dark": {
      "$description": "Animated keyword fill on dark scenes only (all stops ≥4.8:1 on navy-900). Angle 90deg, background-size 300%.",
      "$extensions": {
        "org.portfolio.source": "brief §2/§3 shimmer"
      },
      "$value": [
        {
          "color": "{color.base.shimmer-1}",
          "position": 0
        },
        {
          "color": "{color.base.shimmer-2}",
          "position": 0.25
        },
        {
          "color": "{color.base.shimmer-3}",
          "position": 0.5
        },
        {
          "color": "{color.base.shimmer-4}",
          "position": 0.75
        },
        {
          "color": "{color.base.shimmer-5}",
          "position": 1
        }
      ]
    },
    "emphasis-on-light": {
      "$description": "Keyword sweep on light scenes: ink → blue → ink. Light-scene shimmer stops fail contrast, so only this variant is allowed on light (large text only).",
      "$extensions": {
        "org.portfolio.source": "brief P .commission-copy gradient (#2b313b/#82bcff/#2483ff), adjusted: #82bcff removed"
      },
      "$value": [
        {
          "color": "{color.base.slate-700}",
          "position": 0
        },
        {
          "color": "{color.base.slate-700}",
          "position": 0.38
        },
        {
          "color": "{color.base.shimmer-2}",
          "position": 0.5
        },
        {
          "color": "{color.base.slate-700}",
          "position": 0.62
        },
        {
          "color": "{color.base.slate-700}",
          "position": 1
        }
      ]
    }
