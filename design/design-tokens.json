  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Anuphan",
          "IBM Plex Sans Thai",
          "Noto Sans Thai Looped",
          "Leelawadee UI",
          "Thonburi",
          "Tahoma",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Primary UI + headline family, Thai and Latin in one file. Replaces Google Sans (licence not cleared).",
        "$extensions": {
          "org.portfolio.font": {
            "license": "SIL OFL 1.1, no Reserved Font Name",
            "source": "https://github.com/google/fonts/tree/main/ofl/anuphan (upstream cadsondemak/Anuphan)",
            "axes": "wght 100–700 (variable)",
            "coverage-verified": "Thai U+0E01–0E5B 87/87, Basic Latin + Latin-1 191/191 (fontTools cmap check, 2026-10-09)",
            "notes": "Loopless modern Thai, closest in feel to the brief's geometric sans. Latin design is derived from IBM Plex Sans. Fallback 1: IBM Plex Sans Thai (OFL with Reserved Font Name 'Plex'; static weights; Thai+Latin verified). Fallback 2: Noto Sans Thai Looped (OFL; Latin coverage partial 179/191, so system Latin is used for missing chars). Then OS Thai fonts."
          }
        }
      },
      "hand": {
        "$value": [
          "Mali",
          "Itim",
          "cursive"
        ],
        "$description": "Optional handwritten accent (sticky notes; D-10 = off at launch, so nothing loads in v1.0). Mali is first and is the only accent face that gets loaded (weight 400, lazy, preload: false; ARCHITECTURE §6.5). Itim stays as a local-only fallback name, then the generic cursive. Never for body copy.",
        "$extensions": {
          "org.portfolio.font": {
            "license": "SIL OFL 1.1 (Mali: Cadson Demak; Itim: Cadson Demak/Impallari)",
            "coverage-verified": "Mali: Thai 87/87, Latin-1 190/191 (missing U+00B5); Itim: Thai 87/87, Latin-1 191/191",
            "replaces": "Playpen Sans (Latin-only, see brief §3)",
            "loading": "Mali only, per ARCHITECTURE §6.5 / §12.4 R-8 (Mali ≈32 KB vs Itim ≈62 KB for Thai + Latin at 400). Itim is not @font-face-loaded."
          }
        }
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$description": "Code snippets only (system stack, no download)."
      }
    },
