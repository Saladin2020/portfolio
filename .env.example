# Optional custom origin for metadataBase, canonical, sitemap, robots, JSON-LD, and OG.
# Leave unset on Vercel: the build uses https://$VERCEL_PROJECT_PRODUCTION_URL (a system env var).
# Production builds fail only when both this and VERCEL_PROJECT_PRODUCTION_URL are unset.
# Locally, omit it and the site uses http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com
